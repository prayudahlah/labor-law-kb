    owl:imports <https://example.org/kbr/ketenagakerjaan/regulasi/pp-45-2015> ;
    owl:imports <https://example.org/kbr/ketenagakerjaan/regulasi/pp-46-2015> ;
    owl:imports <https://example.org/kbr/ketenagakerjaan/regulasi/uu-13-2003> ;
    owl:imports <https://example.org/kbr/ketenagakerjaan/regulasi/uu-24-2011> ;
