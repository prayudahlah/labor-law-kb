@prefix ktn:  <https://example.org/kbr/ketenagakerjaan#> .
@prefix reg:  <https://example.org/kbr/regulasi#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/kbr/regulasi> a owl:Ontology ;
    dct:title "Metadata peraturan ketenagakerjaan (individu)" ;
    owl:imports <https://example.org/kbr/regulasi/vocab> .

reg:PP-34-2021 a reg:Peraturan ;
    dct:title "Peraturan Pemerintah Nomor 34 Tahun 2021 tentang Penggunaan Tenaga Kerja Asing" ;
    reg:jenis reg:PeraturanPemerintah ;
    reg:nomor "34" ;
    reg:tahun "2021"^^xsd:gYear ;
    reg:status reg:Berlaku ;
    reg:sumberUtama <https://peraturan.bpk.go.id/Details/161898/pp-no-34-tahun-2021> .

