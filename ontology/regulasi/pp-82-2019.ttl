@prefix ktn:  <https://example.org/kbr/ketenagakerjaan#> .
@prefix reg:  <https://example.org/kbr/regulasi#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/kbr/ketenagakerjaan/regulasi/pp-82-2019> a owl:Ontology ;
    dct:title "Fakta norma: Peraturan Pemerintah Nomor 82 Tahun 2019 tentang Perubahan atas Peraturan Pemerintah Nomor 44 Tahun 2015 tentang Penyelenggaraan Program Jaminan Kecelakaan Kerja dan Jaminan Kematian" ;
    dct:source <https://peraturan.bpk.go.id/Details/127681/pp-no-82-tahun-2019> ;
    owl:imports <https://example.org/kbr/ketenagakerjaan> .

ktn:P82DaluwarsaJkkLimaTahun a owl:NamedIndividual, ktn:KetentuanJaminanSosial ;
    ktn:pasal "Pasal 26" ;
    ktn:berkaitanTopik ktn:TopikJamsos ;
    dct:source reg:PP-82-2019 .

