@prefix ktn:  <https://example.org/kbr/ketenagakerjaan#> .
@prefix reg:  <https://example.org/kbr/regulasi#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/kbr/ketenagakerjaan/regulasi/pp-28-2024> a owl:Ontology ;
    dct:title "Fakta norma: Peraturan Pemerintah Nomor 28 Tahun 2024 tentang Peraturan Pelaksanaan Undang-Undang Nomor 17 Tahun 2023 tentang Kesehatan" ;
    dct:source <https://peraturan.bpk.go.id/Details/294077/pp-no-28-tahun-2024> ;
    owl:imports <https://example.org/kbr/ketenagakerjaan> .

ktn:PendaftaranJamsosTenagaKesehatan a owl:NamedIndividual, ktn:KetentuanJaminanSosial ;
    ktn:pasal "Pasal 730 ayat (2)" ;
    dct:source reg:PP-28-2024 .

ktn:JaminanTenagaCadanganKesehatan a owl:NamedIndividual, ktn:KetentuanJaminanSosial ;
    ktn:pasal "Pasal 636" ;
    dct:source reg:PP-28-2024 .

ktn:KetentuanFasilitasMenyusui a owl:NamedIndividual, ktn:KetentuanKIA ;
    ktn:pasal "Pasal 43 ayat (4)" ;
    dct:source reg:PP-28-2024 .

ktn:KetentuanKebijakanASI a owl:NamedIndividual, ktn:KetentuanKIA ;
    ktn:pasal "Pasal 43 ayat (1)" ;
    dct:source reg:PP-28-2024 .

ktn:KetentuanPeraturanInternalASI a owl:NamedIndividual, ktn:KetentuanKIA ;
    ktn:pasal "Pasal 43 ayat (3)" ;
    dct:source reg:PP-28-2024 .

ktn:KetentuanKesempatanMenyusui a owl:NamedIndividual, ktn:KetentuanKIA ;
    ktn:pasal "Pasal 43 ayat (5)" ;
    dct:source reg:PP-28-2024 .

ktn:THRTenagaKesehatan a owl:NamedIndividual, ktn:KetentuanUpah ;
    ktn:pasal "Pasal 725 ayat (4)" ;
    dct:source reg:PP-28-2024 .
