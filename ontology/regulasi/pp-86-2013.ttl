# =====================================================================
# BERKAS DIGENERATE. JANGAN EDIT MANUAL.
# Sumber   : data/norma.csv, parameter.csv, kategori.csv, pengali_lembur.csv, program_jamsos.csv
# Hasilkan : .venv/bin/python scripts/build_ontology.py
# =====================================================================

@prefix ktn:  <https://example.org/kbr/ketenagakerjaan#> .
@prefix reg:  <https://example.org/kbr/regulasi#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/kbr/ketenagakerjaan/regulasi/pp-86-2013> a owl:Ontology ;
    dct:title "Fakta norma: Peraturan Pemerintah Nomor 86 Tahun 2013 tentang Tata Cara Pengenaan Sanksi Administratif kepada Pemberi Kerja dan Setiap Orang Selain Pemberi Kerja dan Pekerja" ;
    dct:source <https://peraturan.bpk.go.id/Details/5421/pp-no-86-tahun-2013> ;
    owl:imports <https://example.org/kbr/ketenagakerjaan> .

ktn:WajibDaftarPesertaOrang a owl:NamedIndividual, ktn:KetentuanJaminanSosial ;
    ktn:pasal "Pasal 4 ayat (1)" ;
    dct:source reg:PP-86-2013 .

ktn:WajibDaftarPesertaPemberiKerja a owl:NamedIndividual, ktn:KetentuanJaminanSosial ;
    ktn:pasal "Pasal 3 ayat (1)" ;
    dct:source reg:PP-86-2013 .

ktn:LaporPerubahanDataOrang a owl:NamedIndividual, ktn:KetentuanJaminanSosial ;
    ktn:batasHariPencatatan 7 ;
    ktn:pasal "Pasal 4 ayat (4)" ;
    dct:source reg:PP-86-2013 .

ktn:LaporPerubahanDataPemberiKerja a owl:NamedIndividual, ktn:KetentuanJaminanSosial ;
    ktn:batasHariPencatatan 7 ;
    ktn:pasal "Pasal 3 ayat (4)" ;
    dct:source reg:PP-86-2013 .
