@prefix ktn:  <https://example.org/kbr/ketenagakerjaan#> .
@prefix reg:  <https://example.org/kbr/regulasi#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/kbr/ketenagakerjaan/regulasi/pp-55-2015> a owl:Ontology ;
    dct:title "Fakta norma: Peraturan Pemerintah Nomor 55 Tahun 2015 tentang Perubahan atas Peraturan Pemerintah Nomor 99 Tahun 2013 tentang Pengelolaan Aset Jaminan Sosial Ketenagakerjaan" ;
    dct:source <https://peraturan.bpk.go.id/Details/5627/pp-no-55-tahun-2015> ;
    owl:imports <https://example.org/kbr/ketenagakerjaan> .

ktn:KesehatanKeuanganJKKJKM a owl:NamedIndividual, ktn:KetentuanJaminanSosial ;
    ktn:pasal "Pasal 47 ayat (4)" ;
    ktn:berkaitanTopik ktn:TopikJamsos ;
    dct:source reg:PP-55-2015 .

ktn:KesehatanKeuanganJPTindakan a owl:NamedIndividual, ktn:KetentuanJaminanSosial ;
    ktn:pasal "Pasal 47 ayat (7)" ;
    ktn:berkaitanTopik ktn:TopikJamsos ;
    dct:source reg:PP-55-2015 .

ktn:SaranaKesejahteraanRusunSewa a owl:NamedIndividual, ktn:KetentuanJaminanSosial ;
    ktn:pasal "Pasal 64A" ;
    ktn:berkaitanTopik ktn:TopikJamsos ;
    dct:source reg:PP-55-2015 .
