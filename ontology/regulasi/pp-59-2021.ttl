@prefix ktn:  <https://example.org/kbr/ketenagakerjaan#> .
@prefix reg:  <https://example.org/kbr/regulasi#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/kbr/ketenagakerjaan/regulasi/pp-59-2021> a owl:Ontology ;
    dct:title "Fakta norma: Peraturan Pemerintah Nomor 59 Tahun 2021 tentang Pelaksanaan Pelindungan Pekerja Migran Indonesia" ;
    dct:source <https://peraturan.go.id/id/pp-no-59-tahun-2021> ;
    owl:imports <https://example.org/kbr/ketenagakerjaan> .

ktn:JaminanSosialPMI a owl:NamedIndividual, ktn:KetentuanJaminanSosial ;
    ktn:pasal "Pasal 10 ayat (2)" ;
    dct:source reg:PP-59-2021 .
