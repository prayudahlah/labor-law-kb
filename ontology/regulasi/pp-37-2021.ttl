@prefix ktn:  <https://example.org/kbr/ketenagakerjaan#> .
@prefix reg:  <https://example.org/kbr/regulasi#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/kbr/ketenagakerjaan/regulasi/pp-37-2021> a owl:Ontology ;
    dct:title "Fakta norma: Peraturan Pemerintah Nomor 37 Tahun 2021 tentang Penyelenggaraan Program Jaminan Kehilangan Pekerjaan" ;
    dct:source <https://peraturan.bpk.go.id/Details/161919/pp-no-37-tahun-2021> ;
    owl:imports <https://example.org/kbr/ketenagakerjaan> .

ktn:JKK-R1 a owl:NamedIndividual, ktn:ProgramJaminanSosial ;
    ktn:jenisProgram "JKK" ;
    ktn:tarifPengusahaPersen 0.1 ;
    ktn:tarifPekerjaPersen 0 ;
    ktn:tarifTotalPersen 0.1 ;
    ktn:tingkatRisiko "sangat_rendah" ;
    ktn:pasal "PP 37/2021 Pasal 11 ayat (5)a.1" .

ktn:JKK-R2 a owl:NamedIndividual, ktn:ProgramJaminanSosial ;
    ktn:jenisProgram "JKK" ;
