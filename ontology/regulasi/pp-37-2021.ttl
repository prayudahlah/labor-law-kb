    ktn:tarifPekerjaPersen 0 ;
    ktn:tarifTotalPersen 0.4 ;
    ktn:tingkatRisiko "rendah" ;
    ktn:pasal "PP 37/2021 Pasal 11 ayat (5)a.2" .

ktn:JKK-R3 a owl:NamedIndividual, ktn:ProgramJaminanSosial ;
    ktn:jenisProgram "JKK" ;
    ktn:tarifPengusahaPersen 0.75 ;
    ktn:tarifPekerjaPersen 0 ;
    ktn:tarifTotalPersen 0.75 ;
    ktn:tingkatRisiko "sedang" ;
    ktn:pasal "PP 37/2021 Pasal 11 ayat (5)a.3" .

ktn:JKK-R4 a owl:NamedIndividual, ktn:ProgramJaminanSosial ;
    ktn:jenisProgram "JKK" ;
    ktn:tarifPengusahaPersen 1.13 ;
    ktn:tarifPekerjaPersen 0 ;
    ktn:tarifTotalPersen 1.13 ;
    ktn:tingkatRisiko "tinggi" ;
    ktn:pasal "PP 37/2021 Pasal 11 ayat (5)a.4" .

ktn:JKK-R5 a owl:NamedIndividual, ktn:ProgramJaminanSosial ;
    ktn:jenisProgram "JKK" ;
    ktn:tarifPengusahaPersen 1.6 ;
    ktn:tarifPekerjaPersen 0 ;
    ktn:tarifTotalPersen 1.6 ;
    ktn:tingkatRisiko "sangat_tinggi" ;
    ktn:pasal "PP 37/2021 Pasal 11 ayat (5)a.5" .

ktn:JKM a owl:NamedIndividual, ktn:ProgramJaminanSosial ;
