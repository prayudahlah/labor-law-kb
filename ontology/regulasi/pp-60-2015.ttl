@prefix ktn:  <https://example.org/kbr/ketenagakerjaan#> .
@prefix reg:  <https://example.org/kbr/regulasi#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/kbr/ketenagakerjaan/regulasi/pp-60-2015> a owl:Ontology ;
    dct:title "Fakta norma: Peraturan Pemerintah Nomor 60 Tahun 2015 tentang Perubahan atas Peraturan Pemerintah Nomor 46 Tahun 2015 tentang Penyelenggaraan Program Jaminan Hari Tua" ;
    dct:source <https://peraturan.bpk.go.id/Details/5634/pp-no-60-tahun-2015> ;
    owl:imports <https://example.org/kbr/ketenagakerjaan> .

ktn:ManfaatJHTWajibDibayar a owl:NamedIndividual, ktn:KetentuanJaminanSosial ;
    ktn:pasal "Pasal 26 ayat (1)" ;
    dct:source reg:PP-60-2015 .

ktn:ManfaatJHTAhliWaris a owl:NamedIndividual, ktn:KetentuanJaminanSosial ;
    ktn:pasal "Pasal 26 ayat (4)" ;
    dct:source reg:PP-60-2015 .

ktn:ManfaatJHTCacatTotalTetap a owl:NamedIndividual, ktn:KetentuanJaminanSosial ;
    ktn:pasal "Pasal 26 ayat (3)" ;
    dct:source reg:PP-60-2015 .

ktn:ManfaatJHTUsiaPensiun a owl:NamedIndividual, ktn:KetentuanJaminanSosial ;
    ktn:pasal "Pasal 26 ayat (2)" ;
    dct:source reg:PP-60-2015 .
