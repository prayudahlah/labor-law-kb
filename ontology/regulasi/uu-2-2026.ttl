@prefix ktn:  <https://example.org/kbr/ketenagakerjaan#> .
@prefix reg:  <https://example.org/kbr/regulasi#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/kbr/ketenagakerjaan/regulasi/uu-2-2026> a owl:Ontology ;
    dct:title "Fakta norma: Undang-Undang Nomor 2 Tahun 2026 tentang Pelindungan Pekerja Rumah Tangga" ;
    dct:source <https://www.peraturan.go.id/id/uu-no-2-tahun-2026> ;
    owl:imports <https://example.org/kbr/ketenagakerjaan> .

ktn:PRTHakCutiKesepakatan a owl:NamedIndividual, ktn:KetentuanWaktuKerja ;
    ktn:pasal "Pasal 15 ayat (1) huruf d" ;
    ktn:berkaitanTopik ktn:TopikCuti ;
    dct:source reg:UU-2-2026 .

ktn:PRTIuranKesehatanNonPBI a owl:NamedIndividual, ktn:KetentuanJaminanSosial ;
    ktn:pasal "Pasal 16 ayat (2)" ;
    ktn:berkaitanTopik ktn:TopikJamsos ;
    dct:source reg:UU-2-2026 .

