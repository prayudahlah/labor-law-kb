@prefix ktn:  <https://example.org/kbr/ketenagakerjaan#> .
@prefix reg:  <https://example.org/kbr/regulasi#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/kbr/ketenagakerjaan/regulasi/uu-4-2023> a owl:Ontology ;
    dct:title "Fakta norma: Undang-Undang Nomor 4 Tahun 2023 tentang Pengembangan dan Penguatan Sektor Keuangan" ;
    dct:source <https://peraturan.bpk.go.id/Details/240203/uu-no-4-tahun-2023> ;
    owl:imports <https://example.org/kbr/ketenagakerjaan> .

ktn:JHTAhliWaris a owl:NamedIndividual, ktn:KetentuanJaminanSosial ;
    ktn:pasal "Pasal 37 ayat (6)" ;
    ktn:berkaitanTopik ktn:TopikJamsos ;
    dct:source reg:UU-4-2023 .

ktn:JHTAksesMendesak a owl:NamedIndividual, ktn:KetentuanJaminanSosial ;
    ktn:pasal "Pasal 37 ayat (3)" ;
    ktn:berkaitanTopik ktn:TopikJamsos ;
    dct:source reg:UU-4-2023 .

ktn:JHTAkunUtamaTambahan a owl:NamedIndividual, ktn:KetentuanJaminanSosial ;
    ktn:pasal "Pasal 36 ayat (2) dan ayat (3)" ;
    ktn:berkaitanTopik ktn:TopikJamsos ;
    dct:source reg:UU-4-2023 .

ktn:JHTBesaranManfaat a owl:NamedIndividual, ktn:KetentuanJaminanSosial ;
    ktn:pasal "Pasal 37 ayat (1)" ;
    ktn:berkaitanTopik ktn:TopikJamsos ;
    dct:source reg:UU-4-2023 .

ktn:JHTImbalHasilMinimal a owl:NamedIndividual, ktn:KetentuanJaminanSosial ;
    ktn:pasal "Pasal 37 ayat (4) dan ayat (5)" ;
    ktn:berkaitanTopik ktn:TopikJamsos ;
    dct:source reg:UU-4-2023 .

ktn:JHTIuranBukanPenerimaUpah a owl:NamedIndividual, ktn:KetentuanJaminanSosial ;
    ktn:pasal "Pasal 38 ayat (2)" ;
    ktn:berkaitanTopik ktn:TopikJamsos ;
    dct:source reg:UU-4-2023 .

ktn:JHTIuranPenerimaUpah a owl:NamedIndividual, ktn:KetentuanJaminanSosial ;
    ktn:pasal "Pasal 38 ayat (1)" ;
    ktn:berkaitanTopik ktn:TopikJamsos ;
    dct:source reg:UU-4-2023 .

ktn:JHTPembayaranManfaat a owl:NamedIndividual, ktn:KetentuanJaminanSosial ;
    ktn:pasal "Pasal 37 ayat (2)" ;
    ktn:berkaitanTopik ktn:TopikJamsos ;
    dct:source reg:UU-4-2023 .
