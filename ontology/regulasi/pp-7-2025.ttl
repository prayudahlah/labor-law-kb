@prefix ktn:  <https://example.org/kbr/ketenagakerjaan#> .
@prefix reg:  <https://example.org/kbr/regulasi#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/kbr/ketenagakerjaan/regulasi/pp-7-2025> a owl:Ontology ;
    dct:title "Fakta norma: Peraturan Pemerintah Nomor 7 Tahun 2025 tentang Penyesuaian Iuran Jaminan Kecelakaan Kerja Industri Padat Karya Tertentu Tahun 2025" ;
    dct:source <https://peraturan.bpk.go.id/Details/314624/pp-no-7-tahun-2025> ;
    owl:imports <https://example.org/kbr/ketenagakerjaan> .

ktn:JkkBatasBayarIuran a owl:NamedIndividual, ktn:KetentuanJaminanSosial ;
    ktn:pasal "Pasal 6 ayat (1)" ;
    ktn:berkaitanTopik ktn:TopikJamsos ;
    dct:source reg:PP-7-2025 .

