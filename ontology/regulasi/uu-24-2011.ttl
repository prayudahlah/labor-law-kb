@prefix ktn:  <https://example.org/kbr/ketenagakerjaan#> .
@prefix reg:  <https://example.org/kbr/regulasi#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/kbr/ketenagakerjaan/regulasi/uu-24-2011> a owl:Ontology ;
    dct:title "Fakta norma: Undang-Undang Nomor 24 Tahun 2011 tentang Badan Penyelenggara Jaminan Sosial" ;
    dct:source <https://peraturan.bpk.go.id/Details/39268/uu-no-24-tahun-2011> ;
    owl:imports <https://example.org/kbr/ketenagakerjaan> .

ktn:KetentuanProgramJamsos a owl:NamedIndividual, ktn:KetentuanJaminanSosial ;
    ktn:pasal "Pasal 6 ayat (2)" ;
    dct:source reg:UU-24-2011 .
