@prefix ktn:  <https://example.org/kbr/ketenagakerjaan#> .
@prefix reg:  <https://example.org/kbr/regulasi#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/kbr/ketenagakerjaan/regulasi/uu-17-2023> a owl:Ontology ;
    dct:title "Fakta norma: Undang-Undang Nomor 17 Tahun 2023 tentang Kesehatan" ;
    dct:source <https://peraturan.go.id/id/uu-no-17-tahun-2023> ;
    owl:imports <https://example.org/kbr/ketenagakerjaan> .

ktn:FasilitasMenyusuiTempatKerja a owl:NamedIndividual, ktn:KetentuanKIA ;
    ktn:pasal "Pasal 42 ayat (3)" ;
    dct:source reg:UU-17-2023 .
