@prefix ktn:  <https://example.org/kbr/ketenagakerjaan#> .
@prefix reg:  <https://example.org/kbr/regulasi#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/kbr/ketenagakerjaan/regulasi/pp-22-2022> a owl:Ontology ;
    dct:title "Fakta norma: Peraturan Pemerintah Nomor 22 Tahun 2022 tentang Penempatan dan Pelindungan Awak Kapal Niaga Migran dan Awak Kapal Perikanan Migran" ;
    dct:source <https://peraturan.go.id/id/pp-no-22-tahun-2022> ;
    owl:imports <https://example.org/kbr/ketenagakerjaan> .

ktn:JamsosCalonAwakNiagaMigran a owl:NamedIndividual, ktn:KetentuanJaminanSosial ;
    ktn:pasal "Pasal 15 huruf d" ;
    dct:source reg:PP-22-2022 .

ktn:JamsosCalonAwakPerikananMigran a owl:NamedIndividual, ktn:KetentuanJaminanSosial ;
    ktn:pasal "Pasal 31 huruf d" ;
    dct:source reg:PP-22-2022 .

ktn:ImbalanKelebihanWaktuKerjaAwakNiaga a owl:NamedIndividual, ktn:KetentuanLembur ;
    ktn:pasal "Pasal 21" ;
    dct:source reg:PP-22-2022 .

ktn:ImbalanKelebihanWaktuKerjaAwakPerikanan a owl:NamedIndividual, ktn:KetentuanLembur ;
    ktn:pasal "Pasal 37" ;
    dct:source reg:PP-22-2022 .

ktn:PKLWajibAwakNiagaMigran a owl:NamedIndividual, ktn:KetentuanPKWT ;
    ktn:pasal "Pasal 17 ayat (1)" ;
    dct:source reg:PP-22-2022 .

ktn:PKLWajibAwakPerikananMigran a owl:NamedIndividual, ktn:KetentuanPKWT ;
    ktn:pasal "Pasal 33 ayat (1)" ;
    dct:source reg:PP-22-2022 .

ktn:CutiTanpaPenahananUpahAwakNiaga a owl:NamedIndividual, ktn:KetentuanUpah ;
    ktn:pasal "Pasal 19 ayat (4)" ;
    dct:source reg:PP-22-2022 .

ktn:CutiTanpaPenahananUpahAwakPerikanan a owl:NamedIndividual, ktn:KetentuanUpah ;
    ktn:pasal "Pasal 35 ayat (4)" ;
    dct:source reg:PP-22-2022 .

ktn:WaktuKerjaAwakNiagaMigran a owl:NamedIndividual, ktn:KetentuanWaktuKerja ;
    ktn:jamKerjaPerHari 14 ;
    ktn:jamKerjaPerMinggu 72 ;
    ktn:pasal "Pasal 17 ayat (3)" ;
    dct:source reg:PP-22-2022 .
