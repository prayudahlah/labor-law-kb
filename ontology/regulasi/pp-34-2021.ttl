@prefix ktn:  <https://example.org/kbr/ketenagakerjaan#> .
@prefix reg:  <https://example.org/kbr/regulasi#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/kbr/ketenagakerjaan/regulasi/pp-34-2021> a owl:Ontology ;
    dct:title "Fakta norma: Peraturan Pemerintah Nomor 34 Tahun 2021 tentang Penggunaan Tenaga Kerja Asing" ;
    dct:source <https://peraturan.bpk.go.id/Details/161898/pp-no-34-tahun-2021> ;
    owl:imports <https://example.org/kbr/ketenagakerjaan> .

ktn:JabatanDapatDidudukiTKA a owl:NamedIndividual, ktn:KetentuanTKA ;
    ktn:pasal "Pasal 2 ayat (2)" ;
    dct:source reg:PP-34-2021 .

ktn:UtamakanTenagaKerjaIndonesia a owl:NamedIndividual, ktn:KetentuanTKA ;
    ktn:pasal "Pasal 2 ayat (1)" ;
    dct:source reg:PP-34-2021 .
