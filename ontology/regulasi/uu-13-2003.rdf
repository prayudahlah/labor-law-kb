    <ktn:jamKerjaPerMinggu rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">40</ktn:jamKerjaPerMinggu>
    <ktn:jumlahHariKerjaPerMinggu rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</ktn:jumlahHariKerjaPerMinggu>
    <ktn:pasal>Pasal 77 ayat (2) huruf a</ktn:pasal>
    <ktn:tautanSumber rdf:resource="https://peraturan.bpk.go.id/Details/43013/uu-no-13-tahun-2003"/>
  </rdf:Description>
