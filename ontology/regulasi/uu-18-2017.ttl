@prefix ktn:  <https://example.org/kbr/ketenagakerjaan#> .
@prefix reg:  <https://example.org/kbr/regulasi#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/kbr/ketenagakerjaan/regulasi/uu-18-2017> a owl:Ontology ;
    dct:title "Fakta norma: Undang-Undang Nomor 18 Tahun 2017 tentang Pelindungan Pekerja Migran Indonesia" ;
    dct:source <https://peraturan.go.id/id/uu-no-18-tahun-2017> ;
    owl:imports <https://example.org/kbr/ketenagakerjaan> .

ktn:PenyelenggaraanJamsosPMI a owl:NamedIndividual, ktn:KetentuanJaminanSosial ;
    ktn:pasal "Pasal 29 ayat (1)" ;
    dct:source reg:UU-18-2017 .

ktn:KerjaSamaRisikoTakTercakup a owl:NamedIndividual, ktn:KetentuanJaminanSosial ;
    ktn:pasal "Pasal 29 ayat (4)" ;
    dct:source reg:UU-18-2017 .

ktn:HakUpahPMI a owl:NamedIndividual, ktn:KetentuanUpah ;
    ktn:pasal "Pasal 6 ayat (1) huruf f" ;
    dct:source reg:UU-18-2017 .
