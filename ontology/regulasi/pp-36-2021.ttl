@prefix ktn:  <https://example.org/kbr/ketenagakerjaan#> .
@prefix reg:  <https://example.org/kbr/regulasi#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/kbr/ketenagakerjaan/regulasi/pp-36-2021> a owl:Ontology ;
    dct:title "Fakta norma: Peraturan Pemerintah Nomor 36 Tahun 2021 tentang Pengupahan" ;
    dct:source <https://peraturan.bpk.go.id/Details/161909/pp-no-36-tahun-2021> ;
    owl:imports <https://example.org/kbr/ketenagakerjaan> .

ktn:KetentuanUpahMinimum a owl:NamedIndividual, ktn:KetentuanUpah ;
    ktn:pasal "Pasal 23" ;
    dct:source reg:PP-36-2021 .

ktn:UpahMinimumMasaKerjaKurang1Tahun a owl:NamedIndividual, ktn:KetentuanUpah ;
    ktn:pasal "Pasal 24" ;
    dct:source reg:PP-36-2021 .
