@prefix ktn:  <https://example.org/kbr/ketenagakerjaan#> .
@prefix reg:  <https://example.org/kbr/regulasi#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/kbr/ketenagakerjaan/regulasi/uu-20-2023> a owl:Ontology ;
    dct:title "Fakta norma: Undang-Undang Nomor 20 Tahun 2023 tentang Aparatur Sipil Negara" ;
    dct:source <https://peraturan.go.id/id/uu-no-20-tahun-2023> ;
    owl:imports <https://example.org/kbr/ketenagakerjaan> .

ktn:JaminanSosialASN a owl:NamedIndividual, ktn:KetentuanJaminanSosial ;
    ktn:pasal "Pasal 21 ayat (6)" ;
    dct:source reg:UU-20-2023 .

ktn:PembiayaanPensiunASN a owl:NamedIndividual, ktn:KetentuanJaminanSosial ;
    ktn:pasal "Pasal 22 ayat (4)" ;
    dct:source reg:UU-20-2023 .

ktn:BatasUsiaPensiunASNAdministrasi a owl:NamedIndividual, ktn:KetentuanJaminanSosial ;
    ktn:usiaPensiunTahun 58 ;
    ktn:pasal "Pasal 55 huruf a angka 2" ;
    dct:source reg:UU-20-2023 .

ktn:BatasUsiaPensiunASNPimpinanTinggi a owl:NamedIndividual, ktn:KetentuanJaminanSosial ;
    ktn:usiaPensiunTahun 60 ;
    ktn:pasal "Pasal 55 huruf a angka 1" ;
    dct:source reg:UU-20-2023 .

ktn:PembayaranPensiunASNSaatBerhenti a owl:NamedIndividual, ktn:KetentuanJaminanSosial ;
    ktn:pasal "Pasal 22 ayat (1)" ;
    dct:source reg:UU-20-2023 .
