  <rdf:Description rdf:nodeID="rule-LEMBUR-PENGALI-TOTAL">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
    <rdfs:label>Lembur: jenis hari + jumlah jam -&gt; total pengali akumulatif</rdfs:label>
    <swrl:body>
      <rdf:Description>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
        <rdf:first>
            <rdf:Description>
              <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
              <swrl:classPredicate rdf:resource="https://example.org/kbr/ketenagakerjaan#Lembur"/>
              <swrl:argument1 rdf:resource="https://example.org/kbr/ketenagakerjaan#v_l"/>
            </rdf:Description>
        </rdf:first>
      <rdf:rest>
        <rdf:Description>
          <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
          <rdf:first>
              <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
                <swrl:propertyPredicate rdf:resource="https://example.org/kbr/ketenagakerjaan#jenisHariLembur"/>
                <swrl:argument1 rdf:resource="https://example.org/kbr/ketenagakerjaan#v_l"/>
                <swrl:argument2 rdf:resource="https://example.org/kbr/ketenagakerjaan#v_jenis"/>
              </rdf:Description>
          </rdf:first>
        <rdf:rest>
          <rdf:Description>
            <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
            <rdf:first>
                <rdf:Description>
                  <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
                  <swrl:propertyPredicate rdf:resource="https://example.org/kbr/ketenagakerjaan#jamLembur"/>
                  <swrl:argument1 rdf:resource="https://example.org/kbr/ketenagakerjaan#v_l"/>
                  <swrl:argument2 rdf:resource="https://example.org/kbr/ketenagakerjaan#v_jam"/>
                </rdf:Description>
            </rdf:first>
          <rdf:rest>
            <rdf:Description>
              <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
              <rdf:first>
                  <rdf:Description>
                    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                    <swrl:classPredicate rdf:resource="https://example.org/kbr/ketenagakerjaan#AkumulasiLembur"/>
                    <swrl:argument1 rdf:resource="https://example.org/kbr/ketenagakerjaan#v_t"/>
                  </rdf:Description>
              </rdf:first>
            <rdf:rest>
