  <rdf:Description rdf:nodeID="rule-LEMBUR-JENIS-HARI-KERJA">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
    <rdfs:label>Lembur: pada hari kerja -&gt; jenis hari_kerja</rdfs:label>
    <swrl:body>
      <rdf:Description>
