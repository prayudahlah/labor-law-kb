{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/kbr/ketenagakerjaan/skema/extraction.schema.json",
  "title": "Extraction Record",
  "description": "Kontrak output LLM (markdown -> fakta kanonik) untuk KB hukum ketenagakerjaan. Normatif: scripts/validate_extraction.py menegakkan aturan yang sama.",
  "type": "object",
  "additionalProperties": false,
  "required": ["spec_version", "vocab_version", "dokumen_id", "status_review", "peraturan", "norma", "cakupan"],
  "properties": {
    "spec_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "vocab_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "dokumen_id": { "type": "string", "pattern": "^(UU|PP)-\\d{1,4}-\\d{4}(-JO-\\d{1,4}-\\d{4})?$" },
    "status_review": { "type": "string", "enum": ["draft", "reviewed"] },
    "peraturan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["judul", "jenis", "nomor", "tahun", "sumber", "status"],
      "properties": {
        "judul": { "type": "string", "minLength": 3 },
        "jenis": { "type": "string", "enum": ["UU", "PP"] },
        "nomor": { "type": "string", "pattern": "^[0-9]+$" },
        "tahun": { "type": "string", "pattern": "^\\d{4}$" },
        "sumber": { "type": "string", "pattern": "^https?://" },
        "status": { "type": "string", "enum": ["Berlaku", "Diubah", "Dicabut"] },
        "diubah_oleh": {
          "type": "array",
          "default": [],
          "items": { "type": "string", "pattern": "^(UU|PP)-\\d{1,4}-\\d{4}(-JO-\\d{1,4}-\\d{4})?$" }
        }
      }
    },
    "norma": {
      "type": "array",
      "items": { "$ref": "#/$defs/norma" }
    },
    "kategori": {
      "type": "array",
      "default": [],
      "items": { "$ref": "#/$defs/kategori" }
    },
    "pengali_lembur": {
      "type": "array",
      "default": [],
      "items": { "$ref": "#/$defs/pengali" }
    },
    "program_jamsos": {
      "type": "array",
      "default": [],
      "items": { "$ref": "#/$defs/program" }
    },
    "cakupan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pasal_diekstrak", "pasal_dilewati"],
      "properties": {
        "lengkap": {
          "type": "boolean",
          "default": false,
          "description": "true = seluruh pasal batang tubuh telah ditinjau; validator mengubah peringatan cakupan menjadi error."
        },
        "pasal_diekstrak": { "type": "array", "items": { "type": "string" } },
        "pasal_dilewati": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["pasal", "alasan"],
            "properties": {
              "pasal": { "type": "string" },
              "alasan": { "type": "string", "minLength": 3 }
            }
          }
        },
        "catatan": { "type": "string" }
      }
    },
    "tidak_termodelkan": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pasal", "ringkasan", "alasan"],
        "properties": {
          "pasal": { "type": "string" },
          "ringkasan": { "type": "string", "minLength": 3 },
          "alasan": { "type": "string", "minLength": 3 }
        }
      }
    }
  },
  "$defs": {
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nama", "nilai"],
      "properties": {
        "nama": { "type": "string" },
        "nilai": { "type": "string", "pattern": "^-?\\d+(\\.\\d+)?$" },
        "satuan": { "type": "string" },
        "jenis": { "type": "string", "enum": ["pengali", "nominal"] },
        "pasal": { "type": "string" },
        "bukti": { "type": "string" }
      }
    },
    "provenance": {
      "type": "object",
      "properties": {
        "pasal": { "type": "string", "minLength": 3 },
        "bukti": { "type": "string", "minLength": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "dasar_keyakinan": { "type": "string", "enum": ["dikutip", "tafsir", "dinamis", "tidak_lengkap"] },
        "catatan": { "type": "string" }
      }
    },
    "norma": {
      "type": "object",
      "additionalProperties": false,
      "required": ["norm_id", "topik", "pasal", "iri_individu", "jenis", "kondisi", "akibat", "bukti", "confidence", "dasar_keyakinan"],
      "properties": {
        "norm_id": { "type": "string", "pattern": "^[A-Z0-9]+(-[A-Z0-9]+)+$" },
        "topik": { "type": "string", "minLength": 2 },
        "pasal": { "type": "string", "minLength": 3 },
        "iri_individu": { "type": "string", "pattern": "^ktn:[A-Z][A-Za-z0-9]*$" },
        "jenis": { "type": "string" },
        "kondisi": { "type": "string", "minLength": 3 },
        "akibat": { "type": "string", "minLength": 1 },
        "parameter": { "type": "array", "items": { "$ref": "#/$defs/parameter" } },
        "bukti": { "type": "string", "minLength": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "dasar_keyakinan": { "type": "string", "enum": ["dikutip", "tafsir", "dinamis", "tidak_lengkap"] },
        "catatan": { "type": "string" }
      }
    },
    "kategori": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tabel_id", "nama_tabel", "min_bulan", "nilai_bulan", "pasal", "confidence", "dasar_keyakinan"],
      "properties": {
        "tabel_id": { "type": "string", "pattern": "^[A-Z0-9]+(-[A-Z0-9]+)+$" },
        "nama_tabel": { "type": "string", "enum": ["uang_pesangon", "upmk"] },
        "min_bulan": { "type": "integer", "minimum": 0 },
        "max_bulan": { "type": ["integer", "null"], "minimum": 0 },
        "nilai_bulan": { "type": "number" },
        "pasal": { "type": "string", "minLength": 3 },
        "bukti": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "dasar_keyakinan": { "type": "string", "enum": ["dikutip", "tafsir", "dinamis", "tidak_lengkap"] },
        "catatan": { "type": "string" }
      }
    },
    "pengali": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tabel_id", "jenis_hari", "jam_min", "jam_max", "pengali", "pasal", "confidence", "dasar_keyakinan"],
      "properties": {
        "tabel_id": { "type": "string", "pattern": "^[A-Z0-9]+(-[A-Z0-9]+)+$" },
        "jenis_hari": { "type": "string", "enum": ["hari_kerja", "libur_6hari", "libur_terpendek", "libur_5hari"] },
        "jam_min": { "type": "integer", "minimum": 0 },
        "jam_max": { "type": "integer", "minimum": 0 },
        "pengali": { "type": "number" },
        "pasal": { "type": "string", "minLength": 3 },
        "bukti": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "dasar_keyakinan": { "type": "string", "enum": ["dikutip", "tafsir", "dinamis", "tidak_lengkap"] },
        "catatan": { "type": "string" }
      }
    },
    "program": {
      "type": "object",
      "additionalProperties": false,
      "required": ["program_id", "nama", "jenis_program", "tarif_pengusaha_persen", "tarif_pekerja_persen", "tarif_total_persen", "pasal", "confidence", "dasar_keyakinan"],
      "properties": {
        "program_id": { "type": "string", "pattern": "^[A-Z0-9]+(-[A-Z0-9]+)*$" },
        "nama": { "type": "string", "minLength": 3 },
        "jenis_program": { "type": "string", "enum": ["JKK", "JKM", "JHT", "JP"] },
        "tarif_pengusaha_persen": { "type": "number", "minimum": 0 },
        "tarif_pekerja_persen": { "type": "number", "minimum": 0 },
        "tarif_total_persen": { "type": "number", "minimum": 0 },
        "tingkat_risiko": { "type": ["string", "null"] },
        "pasal": { "type": "string", "minLength": 3 },
        "bukti": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "dasar_keyakinan": { "type": "string", "enum": ["dikutip", "tafsir", "dinamis", "tidak_lengkap"] },
        "catatan": { "type": "string" }
      }
    }
  }
}
